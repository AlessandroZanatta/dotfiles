{
  "custom/updates": {
    "format": "{icon} {text}",
    "return-type": "json",
    "format-icons": {
        "has-updates": "󱍷",
        "updated": "󰏗"
    },
    "on-click": "kitty yay -Syu",
    "exec-if": "which waybar-module-pacman-updates",
    "exec": "waybar-module-pacman-updates --interval-seconds 5 --network-interval-seconds 1800"
  }
}
