{
  "hyprland/workspaces": {
    "format": "{icon} {windows}",
    "persistent-workspaces": {
      "*": 5
    },
    "window-rewrite-default": "󰊠",
    "format-icons": {
      "active": "󰮯",
      "special": "󱁂",
      "default": "󰊠",
      "urgent": "󰧵",
      "empty": ""
    },
    "show-special": true,
    "all-outputs": true,
    "workspace-taskbar": {
        "enable": true,
        "on-click-window": "~/.config/waybar/scripts/focus-window.sh {address} {button}",
        "icon-theme": "Adawaita",
        "format": "{icon}",
        "icon-size": 16
    }
  }
}
